{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (status) (argo_workflows_count{namespace=\"tools\"})", "legendFormat": "{{status}}", "refId": "A"}],
      "title": "Workflows by status",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(argo_workflows_operation_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "Controller operation latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum by (phase) (argo_workflows_gauge{namespace=\"tools\"})", "legendFormat": "{{phase}}", "refId": "A"}],
      "title": "Active workflow phases",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 41,
  "tags": ["argo", "agents", "workflows"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "title": "Argo Agent Workflows",
  "uid": "cogito-argo-workflows",
  "version": 1
}
