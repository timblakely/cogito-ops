{
  "title": "LLM Serving Engines",
  "uid": "cogito-llm-serving",
  "tags": [
    "llm",
    "llmkube",
    "inference"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "lane",
        "label": "Serving lane",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "query": "label_values({__name__=~\"llamacpp:requests_processing|vllm:num_requests_running|radiance:http_queue_depth\"}, service)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Serving lanes",
      "description": "Distinct llmkube inference services reporting engine metrics right now. A lane disappears when its pods stop being scraped (scaled to zero, suspended, or recreated).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by (service) ({__name__=~\"llamacpp:requests_processing|vllm:num_requests_running|radiance:http_queue_depth\"}))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Engine families",
      "description": "How many distinct engine metric families are live: llama.cpp, vLLM and Radiance each contribute their own prefix, all scraped by the llmkube-inference PodMonitor.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by (__name__) (group by (__name__) ({__name__=~\"llamacpp:requests_processing|vllm:num_requests_running|radiance:http_queue_depth\"})))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scrape targets down",
      "description": "llmkube-inference targets whose last scrape failed. Engine metrics only exist where the server is reachable on its /metrics endpoint - a lane with --metrics missing shows as absent, not down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(up{job=\"llmkube-inference\"} == 0) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "LiteLLM in-flight",
      "description": "HTTP requests in flight on the proxy (summed across uvicorn workers). Proxy-level only: this is NOT engine concurrency - see the Concurrency row for slots.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(litellm_in_flight_requests)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Serving lanes: engine, node, model",
      "description": "One row per inference service. Engine is derived from which metric family the pod emits, NOT from the runtime label: the PodMonitor's `runtime` is 'generic' for any InferenceService that overrides container args, which covers both the llama.cpp muse-glimmer-30b lane and the Radiance flashnext-iggy lane.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [],
          "fields": ""
        },
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(  label_replace(count by (service, model) (radiance:http_queue_depth), \"engine\", \"radiance\", \"\", \"\")\nor label_replace(count by (service, model) (\n     llamacpp:requests_processing\n     unless on (service) (count by (service) (radiance:http_queue_depth))\n   ), \"engine\", \"llama.cpp\", \"\", \"\")\nor label_replace(count by (service, model) (\n     vllm:num_requests_running\n     unless on (service) (\n       count by (service) (radiance:http_queue_depth)\n       or count by (service) (llamacpp:requests_processing)\n     )\n   ), \"engine\", \"vllm\", \"\", \"\"))\n* on (service) group_left (node)\n(count by (service, node) (\n  (up{job=\"llmkube-inference\"} == 1)\n  * on (pod) group_left (node) (count by (pod, node) (kube_pod_info{namespace=\"llm\"}))\n))",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Token throughput by serving model",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Prompt processing speed (tok/s)",
      "description": "Prompt/prefill tokens computed per second, per inference service. Unified across engines from counters: llama.cpp prompt_tokens_total excludes cached tokens, so a cache-hit-heavy lane reads lower than its real wall-clock prefill; Radiance and vLLM prompt counters include cached work.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (rate(llamacpp:prompt_tokens_total{service=~\"$lane\"}[$__rate_interval]))\nor sum by (service) (rate(vllm:prompt_tokens_total{service=~\"$lane\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Generation speed (tok/s)",
      "description": "Generated tokens per second per inference service, summed across replicas - lane throughput, not per-stream speed. Per-stream decode is the native-gauge panel on the right.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (rate(llamacpp:tokens_predicted_total{service=~\"$lane\"}[$__rate_interval]))\nor sum by (service) (rate(vllm:generation_tokens_total{service=~\"$lane\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Prompt processing - engine-native rate (tok/s)",
      "description": "Engine's own prompt-processing rate. Radiance reports prefill_tokens_per_second over the scheduler's recent window; llama.cpp reports prompt_tokens_seconds as a per-scrape bucket that resets on EVERY scrape, so it must be read as an instant gauge - rate() over it is always 0/NaN. Idle lanes read 0 by design.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (service, pod) (radiance:prefill_tokens_per_second{service=~\"$lane\"})\nor max by (service, pod) (llamacpp:prompt_tokens_seconds{service=~\"$lane\"})",
          "refId": "A",
          "legendFormat": "{{service}} {{pod}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Decode speed - engine-native rate (tok/s)",
      "description": "Engine's own decode throughput. Radiance decode_tokens_per_second is a live scheduler-window gauge; llama.cpp predicted_tokens_seconds is the same reset-per-scrape bucket trick (it is NOT a counter-rate), and llama.cpp counts generated tokens so a spec-decoding lane's accepted drafts appear here too.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (service, pod) (radiance:decode_tokens_per_second{service=~\"$lane\"})\nor max by (service, pod) (llamacpp:predicted_tokens_seconds{service=~\"$lane\"})",
          "refId": "A",
          "legendFormat": "{{service}} {{pod}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Decode speed per active stream (tok/s)",
      "description": "Lane decode throughput divided by running requests - what one user perceives. Only meaningful on vLLM/Radiance surfaces (Radiance re-exports the vLLM-compat metrics, so num_requests_running covers it); llama.cpp parallel slots are per-slot, not aggregate-safe.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (service) (radiance:decode_tokens_per_second{service=~\"$lane\"})\n  / clamp_min(max by (service) (vllm:num_requests_running{service=~\"$lane\"}), 1)",
          "refId": "A",
          "legendFormat": "{{service}} (radiance)"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Prompt vs generated tokens (rate)",
      "description": "The prompt:generation ratio per lane tells you whether a lane is doing agentic re-feeding (huge prompt column) or long single generations.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (rate(llamacpp:prompt_tokens_total{service=~\"$lane\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service}} prompt (llama.cpp)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (rate(vllm:prompt_tokens_total{service=~\"$lane\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service}} prompt (vLLM/Radiance)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (rate(llamacpp:tokens_predicted_total{service=~\"$lane\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service}} generated (llama.cpp)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (rate(vllm:generation_tokens_total{service=~\"$lane\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service}} generated (vLLM/Radiance)"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Concurrency & queueing",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Requests in flight (engine view)",
      "description": "llama.cpp counts busy slots (requests_processing); vLLM and Radiance count running requests (num_requests_running). Radiance re-exports the vLLM-compat surface, so one expression covers both; the `or` keeps llama.cpp lanes visible when a vLLM lane is absent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (llamacpp:requests_processing{service=~\"$lane\"})\nor sum by (service) (vllm:num_requests_running{service=~\"$lane\"})",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Queued / deferred at the engine",
      "description": "llama.cpp defers a request when no slot or KV space is free; vLLM/Radiance keep a waiting queue. Sustained nonzero here with idle replicas means the lane is KV- or slot-bound.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (llamacpp:requests_deferred{service=~\"$lane\"})\nor sum by (service) (vllm:num_requests_waiting{service=~\"$lane\"})",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Radiance admission: queue depth & rejects",
      "description": "http_queue_depth is admitted-but-unfinished at the HTTP layer; admission_rejected counts 429s when the admission queue is full. Radiance-specific.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (radiance:http_queue_depth{service=~\"$lane\"})",
          "refId": "A",
          "legendFormat": "{{service}} depth"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (rate(radiance:http_admission_rejected_total{service=~\"$lane\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service}} rejected/s"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "llama.cpp effective batch width",
      "description": "n_busy_slots_per_decode: average slots fed into each llama_decode() call. ~1 means the lane never actually batches (parallel slots configured but unused); N means real batch sharing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg by (service) (llamacpp:n_busy_slots_per_decode{service=~\"$lane\"})",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Proxy concurrency vs engine concurrency",
      "description": "litellm_in_flight_requests is proxy-side HTTP concurrency (no model label, uvicorn-worker livesum) - the gap against engine in-flight is LiteLLM + network overhead, not model work.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 55
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (lane) (label_replace(rate(litellm_deployment_total_requests_total{api_base=~\"https?://$lane\\\\.[^/]*svc\\\\.cluster\\\\.local.*\"}[$__rate_interval]), \"lane\", \"$1\", \"api_base\", \"https?://([^./]+)[.:].*\"))",
          "refId": "A",
          "legendFormat": "{{lane}} started/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
