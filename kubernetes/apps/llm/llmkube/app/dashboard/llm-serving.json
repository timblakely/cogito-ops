          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (service) (vllm:gpu_prefix_cache_hit_rate{service=~\"$lane\"})\nor (\n  sum by (service) (rate(llamacpp:prompt_tokens_cached_total{service=~\"$lane\"}[$__rate_interval]))\n  / clamp_min(\n      sum by (service) (rate(llamacpp:prompt_tokens_cached_total{service=~\"$lane\"}[$__rate_interval]))\n    + sum by (service) (rate(llamacpp:prompt_tokens_total{service=~\"$lane\"}[$__rate_interval])), 1)\n)\nor (\n  sum by (service) (rate(vllm:prefix_cache_hits_total{service=~\"$lane\"}[$__rate_interval]))\n  / clamp_min(sum by (service) (rate(vllm:prefix_cache_queries_total{service=~\"$lane\"}[$__rate_interval])), 1)\n)",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
