{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Coordinator up",
      "id": 1,
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "max(cogito_coordinator_up{namespace=\"home-infra\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat",
      "title": "Queued runs",
      "id": 2,
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "sum(cogito_coordinator_objects{namespace=\"home-infra\",kind=\"run\",state=\"queued\"}) or vector(0)", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat",
      "title": "Pending Matrix messages",
      "id": 3,
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"expr": "sum(cogito_coordinator_objects{namespace=\"home-infra\",kind=\"matrix_outbox\",state=\"pending\"}) or vector(0)", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat",
      "title": "External action errors",
      "id": 4,
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"expr": "sum(cogito_coordinator_external_action_errors{namespace=\"home-infra\"}) or vector(0)", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat",
      "title": "Audit records",
      "id": 5,
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{"expr": "max(cogito_coordinator_audit_events_total{namespace=\"home-infra\"})", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat",
      "title": "Retained artifacts",
      "id": 6,
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{"expr": "max(cogito_coordinator_artifacts_total{namespace=\"home-infra\"})", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "timeseries",
      "title": "Durable objects by lifecycle state",
      "id": 7,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4},
      "targets": [{"expr": "sum by (kind, state) (cogito_coordinator_objects{namespace=\"home-infra\"})", "legendFormat": "{{kind}} / {{state}}", "refId": "A"}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "timeseries",
      "title": "Recorded token usage by role and harness",
      "id": 8,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "sum by (role, harness, direction) (cogito_coordinator_run_usage_tokens_total{namespace=\"home-infra\"})", "legendFormat": "{{role}} / {{harness}} / {{direction}}", "refId": "A"}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["cogito", "matrix", "agents"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
