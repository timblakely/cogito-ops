{
  "title": "GPU Thermal & Fans (iggy R9700)",
  "uid": "cogito-gpu-thermal-r9700",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "regex": "",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Thermals",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "AMD GPU temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "max": 100,
          "thresholds": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "yellow",
              "value": 85
            },
            {
              "color": "red",
              "value": 93
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "amd_fanctl_gpu_temp_c",
          "legendFormat": "gpu {{gpu}} {{pci}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Case / on-board sensors",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "thresholds": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "yellow",
              "value": 85
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "amd_fanctl_board_temp_c",
          "legendFormat": "sensor {{sensor}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Fans",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "GPU blower speed",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rpm",
          "min": 0,
          "thresholds": [
            {
              "color": "green",
              "value": null
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "amd_fanctl_gpu_fan_rpm",
          "legendFormat": "gpu {{gpu}} {{pci}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Applied case fan duty",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": [
            {
              "color": "green",
              "value": null
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "amd_fanctl_applied_duty_percent",
          "legendFormat": "duty",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Case fans (board pwm3-7)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": [
            {
              "color": "green",
              "value": null
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "amd_fanctl_board_pwm_percent",
          "legendFormat": "pwm {{pwm}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Power, VRAM & utilization",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "GPU power",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "max": 450,
          "thresholds": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "red",
              "value": 250
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "amd_fanctl_gpu_power_w",
          "legendFormat": "gpu {{gpu}} {{pci}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "VRAM used",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "thresholds": [
            {
              "color": "green",
              "value": null
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "amd_fanctl_gpu_vram_used_bytes",
          "legendFormat": "gpu {{gpu}} {{pci}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": [
            {
              "color": "green",
              "value": null
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "amd_fanctl_gpu_busy_percent",
          "legendFormat": "gpu {{gpu}} {{pci}}",
          "refId": "A"
        }
      ]
    }
  ]
}
