---
machine:
  type: controlplane
  network:
    hostname: amnesia
    interfaces:
      - deviceSelector:
          driver: r8169
          hardwareAddr: 10:ff:e0:bb:53:d2
        dhcp: true
  install:
    diskSelector:
      model: "Samsung SSD 9100 PRO 2TB"
      serial: S7YCNJ0L214027M
    # Custom-kernel installer (NVIDIA 615.78.08 on Talos v1.14.2), built by
    # https://github.com/timblakely/talos-nvidia-open-extension
    # (hack/rebase-amnesia.sh there). The public factory kernel rejects these
    # signed modules; do not revert this image to factory.talos.dev.
    image: ghcr.io/timblakely/installer-amd64@sha256:78f6941b8aba004a4e7c05de4dfe192097427e8800893ba67fc9986de6b0f703
    wipe: false
  sysctls:
    # Required by the nvidia-open-toolkit system extension.
    net.core.bpf_jit_harden: "1"
  kernel:
    modules:
      - name: nvidia
      - name: nvidia_uvm
      - name: nvidia_modeset
      - name: nvidia_drm
      - name: uinput
  nodeLabels:
    workload.cogito/gaming: "true"
    nvidia.com/device-plugin.config: gaming.yaml
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
provisioning:
  maxSize: 400GiB
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-hostpath
provisioning:
  diskSelector:
    match: system_disk
  minSize: 500GiB
  grow: true
