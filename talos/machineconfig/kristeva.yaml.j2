---
machine:
  type: controlplane
  network:
    hostname: kristeva
    interfaces:
    - interface: bond0
      bond:
        deviceSelectors:
        - driver: igb
          hardwareAddr: 00:1e:67:89:31:3b
        mode: active-backup
      dhcp: true
      mtu: 9000
      vlans:
      - # IOT
        vlanId: 70
        dhcp: false
        mtu: 9000
      - # VPN
        vlanId: 90
        dhcp: false
        mtu: 9000
  install:
    diskSelector:
      model: "Samsung SSD 850"
    image: factory.talos.dev/metal-installer/b5b5595d47b2f5dbbf090293c10f7a95f349f63e684f5eb59288184dde72e13c@sha256:3b6ac4222be62b97f72731857a7ad7313fc6958a930d5301731150c42e4a69f7
    wipe: false
  kernel:
    modules:
    - name: i915
    - name: nvidia
    - name: nvidia_uvm
    - name: nvidia_modeset
    - name: nvidia_drm
  sysctls:
    net.core.bpf_jit_harden: 1
    # Kopia memory-maps one repository index per pack; the default 65,530
    # mappings is insufficient for the shared VolSync repository.
    vm.max_map_count: "262144"
  nodeLabels:
    node-role.kubernetes.io/high-cpu: 'true'
    node-role.kubernetes.io/high-mem: 'true'
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-hostpath
provisioning:
  diskSelector:
    match: disk.model == 'Samsung SSD 990 EVO Plus 2TB'
  minSize: 2TB
