---
machine:
  type: controlplane
  network:
    hostname: kristeva
    interfaces:
    - interface: bond0
      bond:
        deviceSelectors:
        - driver: igb
          hardwareAddr: 00:1e:67:89:31:3b
        mode: active-backup
      dhcp: true
      mtu: 9000
      vlans:
      - # IOT
        vlanId: 70
        dhcp: false
        mtu: 9000
      - # VPN
        vlanId: 90
        dhcp: false
        mtu: 9000
  install:
    diskSelector:
      model: "Samsung SSD 850"
    # Talos v1.14.4, Intel Arc support without NVIDIA extension services.
    image: factory.talos.dev/metal-installer/28e76510b0e7cdf6e142ef7566e75d1df994a0662808e94d5669babc6db6cd5d@sha256:bf4296060aeccffc2b6db9d4192d41833bc1187b872f5c5540126be0e6450496
    wipe: false
  kernel:
    modules:
    - name: i915
  sysctls:
    net.core.bpf_jit_harden: 1
    # Kopia memory-maps one repository index per pack; the default 65,530
    # mappings is insufficient for the shared VolSync repository.
    vm.max_map_count: "262144"
  nodeLabels:
    node-role.kubernetes.io/high-cpu: 'true'
    node-role.kubernetes.io/high-mem: 'true'
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-hostpath
provisioning:
  diskSelector:
    match: disk.model == 'Samsung SSD 990 EVO Plus 2TB'
  minSize: 2TB
