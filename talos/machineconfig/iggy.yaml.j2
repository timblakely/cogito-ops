---
machine:
  type: controlplane
  network:
    hostname: iggy
    interfaces:
    - interface: bond0
      bond:
        deviceSelectors:
        - driver: r8169
          hardwareAddr: 2c:f0:5d:3e:*
        mode: active-backup
      dhcp: true
      mtu: 9000
      vlans:
      - # IOT
        vlanId: 70
        dhcp: false
        mtu: 9000
      - # VPN
        vlanId: 90
        dhcp: false
        mtu: 9000
  install:
    diskSelector:
      model: "Samsung SSD 970 PRO 512GB"
    # R9700 Image Factory schematic; do not apply until the physical GPU swap.
    image: factory.talos.dev/metal-installer/8f5597684d02cedd54a852b60a13f03bd1d65aa6c48e455e54268163e877ac15@sha256:e69839bf73217ac00445d7593e7e9e4d0a26c81c4c29e403816067878780b57c
    wipe: false
  sysctls:
    net.core.bpf_jit_harden: 1
  nodeLabels:
    node-role.kubernetes.io/machine-learning: 'true'
    node-role.kubernetes.io/high-cpu: 'true'
    node-role.kubernetes.io/high-mem: 'true'
    amd.com/gpu.present: 'true'
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-hostpath
provisioning:
  diskSelector:
    match: disk.model == 'Samsung SSD 970 EVO 1TB'
  minSize: 1TB
