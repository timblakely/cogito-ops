---
machine:
  type: controlplane
  network:
    hostname: iggy
    interfaces:
    - interface: bond0
      bond:
        deviceSelectors:
        - driver: r8169
          hardwareAddr: 2c:f0:5d:3e:*
        mode: active-backup
      dhcp: true
      mtu: 9000
      vlans:
      - # IOT
        vlanId: 70
        dhcp: false
        mtu: 9000
      - # VPN
        vlanId: 90
        dhcp: false
        mtu: 9000
  install:
    diskSelector:
      model: "Samsung SSD 970 PRO 512GB"
    # Talos v1.14.4 with stock proprietary NVIDIA 595.91.07 and matched toolkit.
    image: factory.talos.dev/metal-installer/410b6066fd82217b90a0e9623e98378865544b78030cd6a4acfdafefccd59cf4@sha256:93e6f630be612888b72b7a936cd2d9a9581fa2b7d6bb5c2106131aa09bf6e3be
    wipe: false
  sysctls:
    net.core.bpf_jit_harden: 1
  kernel:
    modules:
      - name: nvidia
      - name: nvidia_uvm
      - name: nvidia_modeset
      - name: nvidia_drm
      - name: nct6775 # NCT6797 case-fan sensor/control; modular in Talos 1.14.
  nodeLabels:
    node-role.kubernetes.io/machine-learning: 'true'
    node-role.kubernetes.io/high-cpu: 'true'
    nvidia.com/device-plugin.config: config.yaml
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-hostpath
provisioning:
  diskSelector:
    match: disk.model == 'Samsung SSD 970 EVO 1TB'
  minSize: 1TB
