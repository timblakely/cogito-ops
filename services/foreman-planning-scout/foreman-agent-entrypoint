#!/bin/sh
set -eu

task=""
namespace=""
workspace_root=""
workspace=""
reset_watcher=""
expect=""
for argument in "$@"; do
    if [ -n "$expect" ]; then
        case "$expect" in
            task) task="$argument" ;;
            namespace) namespace="$argument" ;;
            workspace_root) workspace_root="$argument" ;;
        esac
        expect=""
        continue
    fi
    case "$argument" in
        --task) expect="task" ;;
        --namespace) expect="namespace" ;;
        --workspace-dir) expect="workspace_root" ;;
    esac
done

if [ "${1:-}" = "run-task" ] && [ -n "$task" ] \
        && [ -n "$namespace" ] && [ -n "$workspace_root" ]; then
    workspace="$workspace_root/$namespace/$task"
    mkdir -p "$workspace"

    # Foreman v0.9.25 resets this leaf after startup, then skips both clone and
    # recreation for anonymous freeform tasks. Wait for that single reset and
    # restore the empty workspace before the model can invoke its tools.
    (
        while [ -d "$workspace" ]; do
            sleep 0.05
        done
        mkdir -p "$workspace"
    ) &
    reset_watcher="$!"
fi

# The image workflow uses this only to assert workspace initialization without
# requiring Kubernetes credentials. Normal Jobs never set it.
if [ "${FOREMAN_WORKSPACE_INIT_ONLY:-0}" = "1" ]; then
    test -n "$task"
    test -n "$namespace"
    test -n "$workspace_root"
    rmdir "$workspace"
    wait "$reset_watcher"
    test -d "$workspace"
    exit 0
fi

exec /foreman-agent.real "$@"
