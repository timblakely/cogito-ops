{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogito.dev/schema/agent-run-v1alpha1.json",
  "title": "AgentRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "run_id", "work_item", "role", "repository", "base_ref", "objective"],
  "properties": {
    "api_version": {"const": "cogito.dev/v1alpha1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "work_item": {"type": "string", "format": "uri", "pattern": "^https://"},
    "role": {"enum": ["planner", "coordinator", "worker", "reviewer", "worker-escalated", "reviewer-escalated"]},
    "repository": {"type": "string", "format": "uri"},
    "base_ref": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string"}, "default": []},
    "allowed_paths": {"type": "array", "items": {"type": "string"}, "default": []},
    "acceptance_checks": {"type": "array", "items": {"type": "string"}, "default": []},
    "callback": {"type": "object", "default": {}},
    "context": {"type": "object", "default": {}},
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "attempts": {"type": "integer", "minimum": 1},
        "wall_seconds": {"type": "integer", "minimum": 1},
        "token_budget": {"type": "integer", "minimum": 1}
      }, "default": {}
    }
  }
}
