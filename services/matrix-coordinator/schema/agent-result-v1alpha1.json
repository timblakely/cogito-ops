{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogito.dev/schema/agent-result-v1alpha1.json",
  "title": "AgentResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "run_id", "status", "summary"],
  "properties": {
    "api_version": {"const": "cogito.dev/v1alpha1"},
    "run_id": {"type": "string"},
    "status": {"enum": ["succeeded", "failed", "cancelled", "needs_input"]},
    "summary": {"type": "string", "minLength": 1},
    "head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$"},
    "pull_request": {"type": ["string", "null"], "format": "uri"},
    "checks": {"type": "array", "items": {"type": "object"}, "default": []},
    "artifacts": {"type": "array", "items": {"type": "object"}, "default": []},
    "usage": {"type": "object", "default": {}}
  }
}
