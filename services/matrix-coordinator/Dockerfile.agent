FROM docker.io/library/node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5

ARG JJ_VERSION=0.45.1
ARG JJ_SHA256=f35438350b5d61963aac5dd74ede510b31d6b9690769d1a6268cf058cc825f72
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl git openssh-client python3 \
    && curl --fail --location --silent --show-error \
      "https://github.com/jj-vcs/jj/releases/download/v${JJ_VERSION}/jj-v${JJ_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
      --output /tmp/jj.tar.gz \
    && echo "${JJ_SHA256}  /tmp/jj.tar.gz" | sha256sum --check --strict \
    && tar --extract --gzip --file /tmp/jj.tar.gz --directory /usr/local/bin jj \
    && npm install --global --omit=dev \
      @mariozechner/pi-coding-agent@0.73.1 opencode-ai@1.18.30 \
    && rm --recursive --force /var/lib/apt/lists/* /tmp/jj.tar.gz /root/.npm

ENV HOME=/tmp/agent-home \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    GIT_ASKPASS=/app/git-askpass \
    GIT_TERMINAL_PROMPT=0
WORKDIR /app
COPY coordinator /app/coordinator
COPY adapters /app/adapters
COPY schema /app/schema
COPY git-askpass /app/git-askpass
RUN chmod 0755 /app/adapters/* /app/git-askpass \
    && mkdir --parents /workspace /tmp/agent-home \
    && chown --recursive 65532:65532 /app /workspace /tmp/agent-home
USER 65532:65532
ENTRYPOINT ["/app/adapters/contract-adapter"]
