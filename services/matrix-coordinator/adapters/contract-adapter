#!/usr/bin/python3
import json
import sys

if len(sys.argv) != 2 or sys.argv[1] != "start":
    raise SystemExit("usage: contract-adapter start")
request = json.load(sys.stdin)
print(json.dumps({
    "api_version": request["api_version"],
    "run_id": request["run_id"],
    "status": "succeeded",
    "summary": "Contract adapter accepted the run",
    "checks": [{"name": "contract", "status": "passed"}],
    "artifacts": [],
    "usage": {"role": request["role"], "input_tokens": 0, "output_tokens": 0},
}, sort_keys=True))
