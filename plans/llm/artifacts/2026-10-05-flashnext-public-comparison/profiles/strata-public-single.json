{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "flashnext-strata-public-single",
    "namespace": "llm"
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "nodeSelector": {
      "kubernetes.io/hostname": "iggy"
    },
    "tolerations": [
      {
        "key": "node-role.kubernetes.io/control-plane",
        "operator": "Exists",
        "effect": "NoSchedule"
      },
      {
        "key": "amd.com/gpu",
        "operator": "Exists",
        "effect": "NoSchedule"
      }
    ],
    "securityContext": {
      "seccompProfile": {
        "type": "Unconfined"
      }
    },
    "containers": [
      {
        "name": "runtime",
        "image": "docker.io/stilldeadcode/vllm-radiance:0.9.3@sha256:45694209177a55a1ab3ba6702fe6e978b1b66a6e66ae3fc066f8d579f7bc4c25",
        "command": [
          "/bin/bash",
          "-ec",
          "cd /workspace/flashnext-competition/strata/src; exec python3 /workspace/flashnext-competition/strata-bench-adapter.py --engine strata --config /workspace/flashnext-competition/strata-public-single-config.json --host 127.0.0.1 --port 8080"
        ],
        "env": [
          {
            "name": "LD_LIBRARY_PATH",
            "value": "/opt/rocm/core-7.14/lib:/opt/rocm/lib"
          },
          {
            "name": "OMP_WAIT_POLICY",
            "value": "active"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "8",
            "memory": "80Gi",
            "amd.com/gpu": 2,
            "ephemeral-storage": "1Gi"
          },
          "limits": {
            "memory": "114Gi",
            "amd.com/gpu": 2,
            "ephemeral-storage": "8Gi"
          }
        },
        "volumeMounts": [
          {
            "name": "weights",
            "mountPath": "/models"
          },
          {
            "name": "build",
            "mountPath": "/workspace"
          },
          {
            "name": "archive",
            "mountPath": "/archive"
          },
          {
            "name": "ngram",
            "mountPath": "/ngram"
          },
          {
            "name": "shm",
            "mountPath": "/dev/shm"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "weights",
        "persistentVolumeClaim": {
          "claimName": "flashnext-weights"
        }
      },
      {
        "name": "build",
        "persistentVolumeClaim": {
          "claimName": "cuda-dev-workspace"
        }
      },
      {
        "name": "archive",
        "persistentVolumeClaim": {
          "claimName": "llm-model-archive"
        }
      },
      {
        "name": "ngram",
        "persistentVolumeClaim": {
          "claimName": "flashnext-iggy-ngram"
        }
      },
      {
        "name": "shm",
        "emptyDir": {
          "medium": "Memory",
          "sizeLimit": "64Gi"
        }
      }
    ],
    "initContainers": [
      {
        "image": "docker.io/stilldeadcode/vllm-radiance:0.9.3@sha256:45694209177a55a1ab3ba6702fe6e978b1b66a6e66ae3fc066f8d579f7bc4c25",
        "volumeMounts": [
          {
            "name": "weights",
            "mountPath": "/models"
          },
          {
            "name": "build",
            "mountPath": "/workspace"
          },
          {
            "name": "archive",
            "mountPath": "/archive"
          },
          {
            "name": "ngram",
            "mountPath": "/ngram"
          },
          {
            "name": "shm",
            "mountPath": "/dev/shm"
          }
        ],
        "name": "numerical-qualification",
        "command": [
          "/bin/bash",
          "-ec",
          "for d in 1 0; do export ROCR_VISIBLE_DEVICES=\"$d\" HIP_VISIBLE_DEVICES=0 LD_LIBRARY_PATH=/opt/rocm/core-7.14/lib:/opt/rocm/lib; echo QUALIFY_PHYSICAL_GPU:$d; /workspace/flashnext-competition/strata/build/hip_prefill_mmq_parity; /workspace/flashnext-competition/strata/build/hip_prompt_attn_wmma 32768 2048 3; /workspace/flashnext-competition/strata/build/hip_router_fast; done"
        ],
        "resources": {
          "requests": {
            "cpu": "1",
            "memory": "1Gi",
            "amd.com/gpu": 2
          },
          "limits": {
            "cpu": "2",
            "memory": "4Gi",
            "amd.com/gpu": 2
          }
        }
      }
    ]
  }
}
